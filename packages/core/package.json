{
  "name": "@metaharness/core",
  "version": "0.0.0",
  "description": "Core TypeScript harness API, portable event model, run store, ledgers, compare, handoff, and doctor checks.",
  "keywords": [
    "metaharness",
    "coding-agents",
    "ai-agents",
    "automation",
    "sdk",
    "orchestration"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target node22 --platform node --splitting false --external @metaharness/policy",
    "test": "pnpm --workspace-root build && vitest run --config ../../vitest.config.ts --project core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
