# Optional live-provider test environment.
# The repo does not auto-load this file. Copy the values into your shell,
# secret manager, or a local ignored .env file before running live tests.

ANTHROPIC_API_KEY=
CURSOR_API_KEY=
OPENAI_API_KEY=

# Live provider gates must be exactly 1 when enabled. Keep these blank for
# normal credential-free validation and mock-only integration tests.
metaharness_TEST_CLAUDE=
metaharness_TEST_CURSOR=
metaharness_TEST_CODEX=
metaharness_TEST_CODEX_APPSERVER=
